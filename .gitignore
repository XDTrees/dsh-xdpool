node_modules/
.pnpm-store/
# NOTE: lib/ is intentionally tracked. Shipping the built output means a
# `dsh plugin add github:...` install needs no install-time script: pnpm 11
# blocks those by default, and a missing build leaves no lib/index.js to load.
# Re-run `pnpm build` and commit lib/ alongside any src change.
coverage/
*.log
.env
.DS_Store
.dsh-vision-router/

# 本地用的一次性/中间文件，不属于仓库内容
.ghtok
.gh-token.tmp
release-body.md
release-title.txt
.releases.json
.release-bodies.json
.m.txt
.cm.txt
NPM-FIRST-PUBLISH.md
*.tgz
# Release bodies are generated per version from CHANGELOG.md and handed to
# `gh release create` / tools/create-release.mjs; they are not source.
_release-*.md

# 待处理的截图暂存
.shot-*.png

# Local deployment backups of lib/ (never commit these)
_backup-lib-*/

# Hand-patched copies of the vendored pack, and one-off working notes that live
# in the checkout but are not part of the product.
#
# Both slipped into a commit once, via a `git add -A` used to take a checkpoint.
# The `.bak` is a full copy of `vendor/channel-pack/pack.js` with a local patch
# applied — 2.9 MB, and it carries the upstream credential-shaped strings the
# pack already has, so GitHub's secret scanning refused the push and the whole
# branch had to be rewritten. `*patched-local*` catches the date-stamped names
# future patches will use; the notes file is listed so nobody re-adds it either.
pack.js.patched-local-*.bak
FIX-*-NOTES.md
